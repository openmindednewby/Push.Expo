<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Push.Expo</RootNamespace>
    <PackageId>Push.Expo</PackageId>
    <Description>Expo push-notification provider for .NET. Sends mobile push via the Expo push API (exp.host) with per-token delivery results and DeviceNotRegistered detection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
